# ~/.localrc — machine-specific shell setup
#
# This file is sourced from zsh/zshrc.symlink. Put anything here that should
# NOT be tracked in the dotfiles repo: machine-specific PATH entries,
# work-only env vars, host-specific aliases.
#
# ./install creates it from this example; ./install and ./update keep it
# private (chmod go-rwx) because it is sourced by every shell.

# --- SSH agent ---
# eval "$(ssh-agent)"

# --- PATH additions ---
# export PATH="$PATH:$HOME/opt/some-tool/bin"
# export PATH="$PATH:$HOME/go/bin"

# --- Work / company env vars ---
# Do not export secrets here: every process you start inherits them. Read
# them when a command needs them instead, e.g. from a CLI's own store:
#   acme() { ACME_API_TOKEN="$(security find-generic-password -s acme -w)" command acme "$@"; }
# On work machines, `with_artifactstore <cmd>` (zsh/profiles/zprofile-work.zsh)
# provides ARTIFACTSTORE_USER/ARTIFACTSTORE_TOKEN to that one command.

# --- Tool-specific overrides ---
# export JAVA_HOME=/opt/homebrew/Cellar/openjdk@17/17.0.8.1
# export HOMEBREW_CASK_OPTS="--appdir=~/Applications"
