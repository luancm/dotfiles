# Homebrew packages that these dotfiles configure or call (macOS).
#   brew bundle --file ~/.dotfiles/homebrew/Brewfile         # install
#   brew bundle check --file ~/.dotfiles/homebrew/Brewfile   # report missing
# Work-only and personal apps are not listed here; keep them out of the repo.

