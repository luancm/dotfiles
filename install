#!/usr/bin/env bash
#
# install all things
#
# Flags:
#   --forget-answers  Clear cached install prompt answers and re-ask opt-in bundles.
#   --yes             Accept prompt defaults (non-interactive / CI).
set -euo pipefail

if ((BASH_VERSINFO[0] < 4)); then
	echo "Bash 4+ is required (found $BASH_VERSION). On macOS: brew install bash" >&2
	exit 1
fi

[ "${OSTYPE#*darwin}" = "$OSTYPE" ] && is_mac_os=false || is_mac_os=true

export DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")"; pwd -P)"
source "$DOTFILES/lib/io_handlers.sh"

FORGET_ANSWERS=0
for arg in "$@"; do
	case "$arg" in
		--forget-answers) FORGET_ANSWERS=1 ;;
		--yes|-y)
			export DOTFILES_YES=1
			export DOTFILES_NONINTERACTIVE=1
			;;
		-h|--help)
			cat <<'EOF'
Usage: ./install [--forget-answers] [--yes]

  --forget-answers  Clear cached answers under cache/install-answers and
                    re-prompt for optional dependency bundles on this run.
  --yes, -y         Non-interactive: accept each prompt's default answer.
EOF
			exit 0
			;;
		*)
			log_error "Unknown argument: $arg"
			exit 1
			;;
	esac
done

if [[ "$FORGET_ANSWERS" -eq 1 ]]; then
	clear_install_answers
fi

setup_ssh() {
	if [ -f ~/.ssh/id_ed25519.pub ]; then
		log_success 'SSH: Already configured in ~/.ssh/id_ed25519.pub'
		return 0
	fi

	if ! remembered_confirmation ssh_keygen 'SSH: Do you want to configure ssh?'; then
		log_success 'SSH: Skipping ssh configuration'
		return 0
	fi

	ssh-keygen -t ed25519
	log_success 'SSH: Configured successfully'
}

# ================================================ #
# ============== Start Installation ============== #
# ================================================ #

log_info "❯❯ Installing dependencies..."
bash "$DOTFILES/lib/install_dependencies.sh"

# Call installers
mapfile -t installers < <(find -H "$DOTFILES" -maxdepth 3 -name 'install.sh' -not -path '*.git*')
for installer in "${installers[@]}"; do
	log_info "❯❯ Installing $installer"
	bash "$installer"
done

log_info "❯❯ Creating Symlinks"
# Bootstrap the machine declaration (asks once, never overwrites); the AI
# config gates below read it.
source "$DOTFILES/lib/machine_profile.sh"
ensure_machine_profile
bash "$DOTFILES/lib/create_symlinks.sh"

setup_ssh

bash "$DOTFILES/lib/run_private_hook.sh" install

log_info '❯❯ Linking shared agent configuration'
bash "$DOTFILES/lib/create_agent_symlinks.sh"

log_success 'All installed!'
