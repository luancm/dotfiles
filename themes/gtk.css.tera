---
whiskers:
  version: "^2.9.0"
---
/* Catppuccin {{ flavor.name }} colours for GTK CSS (Waybar, wlogout). */
/* Generated by themes/render.sh from themes/gtk.css.tera. Do not edit. */

@define-color background {{ base | mod(opacity=0.7) | css_rgba }};
{% for id, c in flavor.colors -%}
@define-color {{ id }} #{{ c.hex }};
{% endfor -%}
