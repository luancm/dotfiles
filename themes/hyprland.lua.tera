---
whiskers:
  version: "^2.9.0"
---
-- Catppuccin {{ flavor.name }} palette for Hyprland (Lua).
-- Generated by themes/render.sh from themes/hyprland.lua.tera. Do not edit.

local M = {}
{% for id, c in flavor.colors %}
M.{{ id }} = 'rgb({{ c.hex }})'
M.{{ id }}Alpha = '{{ c.hex }}'
{% endfor %}
return M
