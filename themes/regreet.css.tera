---
whiskers:
  version: "^2.9.0"
---
/* Catppuccin {{ flavor.name }} style for ReGreet (copied to /etc/greetd). */
/* Generated by themes/render.sh from themes/regreet.css.tera. Do not edit. */

/* === Login & Clock boxes === */
 frame.background {
     background-color: {{ base | mod(opacity=0.55) | css_rgba }};
     border: 1px solid {{ text | mod(opacity=0.08) | css_rgba }};
     border-radius: 12px;
 }
 
 frame.background > border {
     border: none;
 }
 
 /* === Inputs === */
 entry,
 combobox,
 .passwordentry {
     background-color: {{ surface0 | mod(opacity=0.6) | css_rgba }};
     border: 1px solid {{ text | mod(opacity=0.12) | css_rgba }};
     border-radius: 6px;
     color: #{{ text.hex }};
 }
 
 entry:focus,
 .passwordentry:focus {
     border-color: {{ blue | mod(opacity=0.6) | css_rgba }};
 }
 
 /* === Login button === */
 button.suggested-action {
     background-color: {{ blue | mod(opacity=0.85) | css_rgba }};
     color: #{{ base.hex }};
     border-radius: 6px;
     border: none;
 }
 
 button.suggested-action:hover {
     background-color: #{{ blue.hex }};
 }
 
 /* === Reboot / Poweroff === */
 button.destructive-action {
     background-color: {{ base | mod(opacity=0.65) | css_rgba }};
     color: #{{ red.hex }};
     border: 1px solid {{ red | mod(opacity=0.6) | css_rgba }};
     border-radius: 6px;
 }
 
 button.destructive-action:hover {
     background-color: {{ red | mod(opacity=0.3) | css_rgba }};
 }
